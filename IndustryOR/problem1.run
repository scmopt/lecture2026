reset;
model problem1.mod;
data problem1.dat;

option solver '/Users/mikiokubo/Documents/ampl/ampl.macos64/gurobi';
solve;

printf "\n========================================\n";
printf "Optimal Objective Value: %g\n", TotalCost;
